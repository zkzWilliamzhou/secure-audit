{
  "name": "secure-audit",
  "version": "0.1.0",
  "description": "AI-powered AST security scanner for frontend JavaScript/TypeScript code. Zero config, privacy-preserving, CI/CD integrated.",
  "keywords": [
    "security",
    "ast",
    "scanner",
    "xss",
    "csrf",
    "vulnerability",
    "typescript",
    "javascript",
    "ci/cd",
    "privacy",
    "gdpr",
    "ccpa",
    "supply-chain",
    "xss-prevention"
  ],
  "author": "SecureAudit Contributors",
  "license": "MIT",
  "bin": {
    "secure-audit": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:security": "jest --testPathPattern=security",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "package": "npm run build && npm pack"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "meow": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/commander": "^12.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "@babel/preset-typescript": "^7.24.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourname/secure-audit.git"
  },
  "bugs": {
    "url": "https://github.com/yourname/secure-audit/issues"
  },
  "homepage": {
    "url": "https://github.com/yourname/secure-audit#readme"
  }
}